    "%@ contacts" : {
      "comment" : "A label at the bottom of the contact cards view that shows the number of contacts. The argument is the number of contacts in the view.",
      "isCommentAutoGenerated" : true
    },
    "%@ events" : {
      "comment" : "A footnote below the file name, showing the number of events in the file.",
      "isCommentAutoGenerated" : true
    },
    "%@ files" : {
      "comment" : "A label that describes the number of files in a file list. The argument is the count of files.",
      "isCommentAutoGenerated" : true
    },
    "%@ invitees" : {
      "comment" : "Pluralization for \"invitees\"",
      "isCommentAutoGenerated" : true
    },
    "%@ more" : {
      "comment" : "A label that describes the number of files that aren't visible in the row. The argument is the number of files that aren't visible.",
      "isCommentAutoGenerated" : true
    },
